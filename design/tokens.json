{
  "name": "noScroll — Put the Phone Down",
  "description": "Single source of truth for noScroll's brand + UI tokens. Consumed manually by ios-app (Asset Catalog / SwiftUI Color) and android-app (Compose Color/Theme). Keep platform themes in sync with this file.",
  "palette": {
    "ink":      { "hex": "#0B1120", "note": "dark base / dark surfaces / primary text on light" },
    "slate":    { "hex": "#55606B", "note": "secondary text / muted UI" },
    "popBlue":  { "hex": "#1F6BFF", "note": "PRIMARY ACCENT — electric blue; CTA / interactive / the slash mark (white text 4.6:1)" },
    "deepBlue": { "hex": "#1650D6", "note": "pressed / deep accent state" },
    "babyBlue": { "hex": "#9FD8F5", "note": "signature accent — light highlight, logo second half" },
    "cloud":    { "hex": "#F2FAFF", "note": "light surface / background" },
    "white":    { "hex": "#FFFFFF", "note": "surface / negative space" },
    "mist":     { "hex": "#9FB3C8", "note": "secondary text on dark" },
    "onAccent":      { "hex": "#FFFFFF", "note": "text/icon on popBlue/deepBlue surfaces" },
    "onAccentMuted": { "hex": "#0B1120", "note": "text/icon on babyBlue surfaces (too light for white text)" },
    "selectedFill":  { "hex": "#E3F3FC", "note": "selected option card / plan card fill (babyBlue tint)" },
    "cardBorder":    { "hex": "#DCE9F3", "note": "1pt hairline around white cards on cloud" }
  },
  "gradients": {
    "accent": { "stops": ["#4A8DFF", "#1F5EFF"], "direction": "leading→trailing", "note": "primary CTA fill" }
  },
  "semantic": {
    "light": {
      "background":     "#F2FAFF",
      "surface":        "#FFFFFF",
      "surfaceVariant": "#E4F1FA",
      "surfaceContainerLowest":  "#FFFFFF",
      "surfaceContainerLow":     "#F8FCFF",
      "surfaceContainer":        "#F2FAFF",
      "surfaceContainerHigh":    "#E4F1FA",
      "surfaceContainerHighest": "#D3E8F5",
      "textPrimary":    "#0B1120",
      "textSecondary":  "#55606B",
      "accent":         "#1F6BFF",
      "accentPressed":  "#1650D6",
      "accentMuted":    "#9FD8F5",
      "onAccent":       "#FFFFFF",
      "onAccentMuted":  "#0B1120",
      "selectedContainer":   "#9FD8F5",
      "onSelectedContainer": "#0B1120",
      "border":         "#DCE9F3",
      "borderVariant":  "#E4F1FA",
      "danger":         "#C0392B",
      "dangerContainer":   "#F6DAD5",
      "onDangerContainer": "#6E1F16"
    },
    "dark": {
      "background":     "#0B1120",
      "surface":        "#141B29",
      "surfaceVariant": "#1C2436",
      "surfaceContainerLowest":  "#0B1120",
      "surfaceContainerLow":     "#10182A",
      "surfaceContainer":        "#141B29",
      "surfaceContainerHigh":    "#1C2436",
      "surfaceContainerHighest": "#232C42",
      "textPrimary":    "#FFFFFF",
      "textSecondary":  "#9FB3C8",
      "accent":         "#1F6BFF",
      "accentPressed":  "#1650D6",
      "accentMuted":    "#9FD8F5",
      "onAccent":       "#FFFFFF",
      "onAccentMuted":  "#0B1120",
      "selectedContainer":   "#9FD8F5",
      "onSelectedContainer": "#0B1120",
      "border":         "#2A3550",
      "borderVariant":  "#1C2436",
      "danger":         "#E07A6E",
      "dangerContainer":   "#5C2A23",
      "onDangerContainer": "#F3C1BA"
    }
  },
  "radius": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "gutter": 20, "cardGap": 12 },
  "typography": {
    "fontFamilySans": "system (SF Pro on iOS, Roboto/system on Android)",
    "fontFamilyMono": "system monospaced",
    "wordmark":  { "weight": 800, "letterSpacing": -1.5 },
    "title":     { "size": 28, "weight": 600 },
    "heading":   { "size": 20, "weight": 600 },
    "body":      { "size": 16, "weight": 400 },
    "caption":   { "size": 13, "weight": 400 },
    "label":     { "size": 11, "weight": 500, "letterSpacing": 0.7, "uppercase": true },
    "numerals":  { "note": "durations/counts use tabular figures (tnum) so timers never jitter" }
  },
  "motion": {
    "durationShortMs": 150,
    "durationMediumMs": 300,
    "durationLongMs": 450,
    "easingEmphasized": [0.2, 0, 0, 1],
    "easingStandard": [0.4, 0, 0.2, 1],
    "note": "one motion vocabulary app-wide: tab crossfades, editor push/pop, chart grow-in, block-screen breathing"
  }
}
